# Copy to .env (setup.sh does this for you) and edit.
# Values here are only the first-boot defaults — everything except the two
# secrets below can also be changed later from the dashboard Settings page.

# Dashboard login password (REQUIRED). Change it.
DASHBOARD_PASSWORD=changeme

# Random secret used to sign session cookies. setup.sh generates a strong one.
SESSION_SECRET=please-generate-a-random-secret

# Where jobs, source videos and generated shorts are stored.
DATA_DIR=./data

# Host / port the server binds to.
HOST=0.0.0.0
PORT=8000

# --- Optional: can also be set from the dashboard Settings page ---
# Google Gemini API key (for highlight detection).
GEMINI_API_KEY=
# Gemini model id. Set to whatever your key can access.
GEMINI_MODEL=gemini-2.5-pro
# Whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# ngrok auth token (only needed if you launch with --tunnel).
NGROK_AUTHTOKEN=
